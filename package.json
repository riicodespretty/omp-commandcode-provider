{
	"name": "omp-commandcode-provider",
	"version": "0.2.5",
	"description": "Command Code model provider for Oh My Pi with a dynamically discovered model catalog",
	"keywords": [
		"command-code",
		"commandcode",
		"llm",
		"oh-my-pi",
		"omp",
		"plugin",
		"provider"
	],
	"homepage": "https://github.com/riicodespretty/omp-commandcode-provider#readme",
	"bugs": {
		"url": "https://github.com/riicodespretty/omp-commandcode-provider/issues"
	},
	"license": "MIT",
	"author": "riicodespretty",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/riicodespretty/omp-commandcode-provider.git"
	},
	"type": "module",
	"scripts": {
		"test": "vp test",
		"typecheck": "tsc --noEmit",
		"lint": "vp lint",
		"format": "vp fmt",
		"check": "vp check",
		"prepare": "git config core.hooksPath .githooks"
	},
	"devDependencies": {
		"@oh-my-pi/pi-ai": "^17.2.9",
		"@oh-my-pi/pi-coding-agent": "^17.2.9",
		"@oxlint/plugins": "^1.79.0",
		"@types/node": "^24.0.0",
		"@vvago/vale": "^3.17.1",
		"typescript": "^5.7.0",
		"vite": "npm:@voidzero-dev/vite-plus-core@0.2.8",
		"vite-plus": "0.2.8"
	},
	"overrides": {
		"vite": "npm:@voidzero-dev/vite-plus-core@0.2.8"
	},
	"devEngines": {
		"packageManager": {
			"name": "bun",
			"version": "1.4.0",
			"onFail": "download"
		}
	},
	"omp": {
		"extensions": [
			"./index.ts"
		]
	},
	"trustedDependencies": [
		"@vvago/vale"
	]
}
